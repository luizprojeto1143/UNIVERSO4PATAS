generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  cnpj                  String?
  stateRegistration     String?
  municipalRegistration String?
  taxRegime             String?  @default("simples_nacional")
  environment           String?  @default("homologation")
  accountantEmail       String?
  autoEmitNotes         Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  units        Unit[]
  users        User[]
  roles        Role[]
  auditLogs    AuditLog[]
  species      Species[]
  breeds       Breed[]
  coatColors   CoatColor[]
  services     Service[]
  products     Product[]
  tutors       Tutor[]
  patients     Patient[]
  clinicalRecords ClinicalRecord[]
  vaccines       Vaccine[]
  invoices     Invoice[]
  signatureDocuments SignatureDocument[]
  appointments Appointment[]
  suppliers    Supplier[]
  fiscalNotes  FiscalNote[]

  @@map("organizations")
}

model Unit {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users          User[]       @relation("UnitUsers")

  @@map("units")
}

model User {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units          Unit[]       @relation("UnitUsers")
  roles          UserRole[]
  permissions    UserPermission[]
  auditLogs      AuditLog[]
  staffProfile   StaffProfile?
  clinicalRecords ClinicalRecord[]
  timelineEvents  TimelineEvent[]
  appointments    Appointment[]

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions    RolePermission[]
  users          UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) 
  action      String   @unique
  description String?

  roles       RolePermission[]
  users       UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     
  permissionId String     
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String     
  permissionId String     
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model UserRole {
  userId String 
  roleId String 
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  entity         String
  entityId       String
  beforeState    String?
  afterState     String?
  createdAt      DateTime     @default(now())

  @@map("audit_logs")
}

model StaffProfile {
  id             String       @id @default(uuid()) 
  userId         String       @unique 
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmv           String?
  uf             String?
  specialties    String

  @@map("staff_profiles")
}

model Species {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  breeds         Breed[]
  patients       Patient[]

  @@map("species")
}

model Breed {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  speciesId      String       
  species        Species      @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patients       Patient[]

  @@map("breeds")
}

model CoatColor {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("coat_colors")
}

model Service {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  basePrice      Float
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoiceItems   InvoiceItem[]

  @@map("services")
}


model Product {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  // Gerais
  sku              String?
  barcode          String?
  isSupply         Boolean      @default(false)
  name             String
  shortDescription String?
  sector           String?
  group            String?
  type             String?
  unit             String?
  costPrice        Float?       @default(0)
  previousCost     Float?
  basePrice        Float        @default(0)
  margin           Float?
  defaultWarehouse String?
  weight           Float?
  minStock         Int?
  maxStock         Int?
  validityDays     Int?
  webDescription   String?
  labelMessage     String?
  lastEntryDate    DateTime?
  imageUrl         String?
  stock            Int          @default(0)

  isActive                 Boolean @default(true)
  receivesNotification     Boolean @default(false)
  controlsBatchAndValidity Boolean @default(false)
  specialControl           Boolean @default(false)
  allowsNegativeStock      Boolean @default(false)
  requiresDoubleCheck      Boolean @default(false)
  requiresPhotoOnCount     Boolean @default(false)
  allowsFractionalCount    Boolean @default(false)

  // Impostos
  icms              Float?
  icmsReduction     Float?
  ipi               Float?
  ipiReturn         Float?
  pis               Float?
  cofins            Float?
  cstCsosn          String?
  cfopInsideState   String?
  cfopOutsideState  String?
  icmsSt            Float?
  ncm               String?
  mva               Float?
  taxSubstitution   Boolean @default(false)
  ncmDescription    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoiceItems   InvoiceItem[]
  productSuppliers ProductSupplier[]

  @@map("products")
}

model Supplier {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  name           String
  document       String?      // CNPJ ou CPF
  contactPerson  String?
  phone          String?
  email          String?
  
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  productSuppliers ProductSupplier[]

  @@map("suppliers")
}

model ProductSupplier {
  productId            String
  supplierId           String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  supplierCode         String?
  lastPrice            Float?
  deliveryLeadTimeDays Int?
  isMainSupplier       Boolean  @default(false)
  lastPurchaseDate     DateTime?

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model Tutor {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  cpf            String?
  phone          String?
  email          String?
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patients       Patient[]
  invoices       Invoice[]
  appointments   Appointment[]
  signatureDocuments SignatureDocument[]

  @@map("tutors")
}

model Patient {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  tutorId        String       
  tutor          Tutor        @relation(fields: [tutorId], references: [id])
  speciesId      String       
  species        Species      @relation(fields: [speciesId], references: [id])
  breedId        String?      
  breed          Breed?       @relation(fields: [breedId], references: [id])
  name           String
  birthDate      DateTime?
  weight         Float?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  alerts         PatientAlert[]
  records        ClinicalRecord[]
  vaccines       Vaccine[]
  appointments   Appointment[]
  signatureDocuments SignatureDocument[]

  @@map("patients")
}

model PatientAlert {
  id             String       @id @default(uuid()) 
  patientId      String       
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  description    String
  severity       String       @default("low")
  createdAt      DateTime     @default(now())

  @@map("patient_alerts")
}

model ClinicalRecord {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String       
  patient        Patient      @relation(fields: [patientId], references: [id])
  veterinarianId String       
  veterinarian   User         @relation(fields: [veterinarianId], references: [id])
  status         String       @default("open")
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?

  events         TimelineEvent[]
  examRequests   ExamRequest[]
  invoices       Invoice[]

  @@map("clinical_records")
}

model TimelineEvent {
  id               String         @id @default(uuid()) 
  clinicalRecordId String         
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  type             String         
  title            String
  description      String?
  data             String?          
  createdBy        String         
  user             User           @relation(fields: [createdBy], references: [id])
  createdAt        DateTime       @default(now())

  @@map("timeline_events")
}

model Vaccine {
  id             String       @id @default(uuid()) 
  patientId      String       
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name           String
  dose           String?
  dateApplied    DateTime?
  nextDueDate    DateTime?
  createdAt      DateTime     @default(now())

  @@map("vaccines")
}

model ExamRequest {
  id               String         @id @default(uuid()) 
  clinicalRecordId String         
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  type             String
  status           String         @default("pending")
  results          String?
  createdAt        DateTime       @default(now())

  @@map("exam_requests")
}

model Invoice {
  id               String         @id @default(uuid()) 
  organizationId   String         
  organization     Organization   @relation(fields: [organizationId], references: [id])
  tutorId          String         
  tutor            Tutor          @relation(fields: [tutorId], references: [id])
  clinicalRecordId String?        
  clinicalRecord   ClinicalRecord? @relation(fields: [clinicalRecordId], references: [id])
  totalAmount      Float          @default(0)
  status           String         @default("pending")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            InvoiceItem[]
  payments         Payment[]
  fiscalNote       FiscalNote?

  @@map("invoices")
}

model InvoiceItem {
  id             String       @id @default(uuid()) 
  invoiceId      String       
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId      String?      
  service        Service?     @relation(fields: [serviceId], references: [id])
  productId      String?      
  product        Product?     @relation(fields: [productId], references: [id])
  quantity       Int          @default(1)
  unitPrice      Float
  totalPrice     Float

  @@map("invoice_items")
}

model Payment {
  id             String       @id @default(uuid()) 
  invoiceId      String       
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Float
  method         String
  date           DateTime     @default(now())

  @@map("payments")
}

model Appointment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  tutorId        String
  tutor          Tutor        @relation(fields: [tutorId], references: [id])
  veterinarianId String
  veterinarian   User         @relation(fields: [veterinarianId], references: [id])
  date           DateTime
  status         String       @default("scheduled") // scheduled, completed, canceled
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("appointments")
}

model FiscalNote {
  id             String       @id @default(uuid()) 
  organizationId String       
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceId      String       @unique
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  type           String       // NFE, NFCE, NFSE
  status         String       @default("PENDING") // PENDING, PROCESSING, AUTHORIZED, REJECTED, CANCELED
  number         String?
  series         String?
  accessKey      String?
  protocol       String?
  xmlData        String?
  pdfUrl         String?
  message        String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("fiscal_notes")
}


