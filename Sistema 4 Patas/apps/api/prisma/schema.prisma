generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String   @id @default(uuid())
  name                  String
  cnpj                  String?
  stateRegistration     String?
  municipalRegistration String?
  taxRegime             String?  @default("simples_nacional")
  environment           String?  @default("homologation")
  accountantEmail       String?
  logoUrl               String? // URL ou Base64 da logo da clínica
  autoEmitNotes         Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  units              Unit[]
  users              User[]
  roles              Role[]
  auditLogs          AuditLog[]
  species            Species[]
  breeds             Breed[]
  coatColors         CoatColor[]
  services           Service[]
  products           Product[]
  tutors             Tutor[]
  patients           Patient[]
  clinicalRecords    ClinicalRecord[]
  invoices           Invoice[]
  signatureDocuments SignatureDocument[]
  appointments       Appointment[]
  suppliers          Supplier[]
  fiscalNotes        FiscalNote[]
  pipelines          Pipeline[]
  documentTemplates  DocumentTemplate[]
  combos             Combo[]
  waitlistEntries    WaitlistEntry[]
  beds               Bed[]
  hospitalizations   Hospitalization[]
  shiftHandovers     ShiftHandover[]
  stockMovements     StockMovement[]
  controlledLogs     ControlledSubstanceLog[]

  @@map("organizations")
}

model Unit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users User[] @relation("UnitUsers")

  @@map("units")
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String
  passwordHash   String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units           Unit[]           @relation("UnitUsers")
  roles           UserRole[]
  permissions     UserPermission[]
  auditLogs       AuditLog[]
  staffProfile    StaffProfile?
  clinicalRecords            ClinicalRecord[]
  timelineEvents             TimelineEvent[]
  appointments               Appointment[]
  hospitalizations           Hospitalization[]
  prescriptionAdministrations PrescriptionAdministration[]
  shiftHandovers             ShiftHandover[]
  stockMovements             StockMovement[]

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique
  description String?

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String
  permissionId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  entity         String
  entityId       String
  beforeState    String?
  afterState     String?
  createdAt      DateTime     @default(now())

  @@map("audit_logs")
}

model StaffProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  crmv        String?
  uf          String?
  specialties String

  @@map("staff_profiles")
}

model Species {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  breeds   Breed[]
  patients Patient[]

  @@map("species")
}

model Breed {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  speciesId      String
  species        Species      @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patients Patient[]

  @@map("breeds")
}

model CoatColor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("coat_colors")
}

model Service {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  costPrice      Float        @default(0)
  basePrice      Float
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoiceItems    InvoiceItem[]
  serviceProducts ServiceProduct[]
  comboServices   ComboService[]

  @@map("services")
}

model ServiceProduct {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Float

  @@map("service_products")
}

model Combo {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  description       String?
  price             Float
  productPercentage Float        @default(60)
  servicePercentage Float        @default(40)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  services     ComboService[]
  products     ComboProduct[]
  invoiceItems InvoiceItem[]

  @@map("combos")
}

model ComboService {
  id        String @id @default(uuid())
  comboId   String
  serviceId String
  quantity  Int    @default(1)

  combo   Combo   @relation(fields: [comboId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@map("combo_services")
}

model ComboProduct {
  id        String @id @default(uuid())
  comboId   String
  productId String
  quantity  Int    @default(1)

  combo   Combo   @relation(fields: [comboId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("combo_products")
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Gerais
  sku              String?
  barcode          String?
  isSupply         Boolean   @default(false)
  name             String
  shortDescription String?
  sector           String?
  group            String?
  type             String?
  unit             String?
  costPrice        Float?    @default(0)
  previousCost     Float?
  basePrice        Float     @default(0)
  margin           Float?
  defaultWarehouse String?
  weight           Float?
  minStock         Int?
  maxStock         Int?
  validityDays     Int?
  webDescription   String?
  labelMessage     String?
  lastEntryDate    DateTime?
  imageUrl         String?
  stock            Int       @default(0)

  isActive                 Boolean @default(true)
  receivesNotification     Boolean @default(false)
  controlsBatchAndValidity Boolean @default(false)
  specialControl           Boolean @default(false)
  allowsNegativeStock      Boolean @default(false)
  requiresDoubleCheck      Boolean @default(false)
  requiresPhotoOnCount     Boolean @default(false)
  allowsFractionalCount    Boolean @default(false)

  // Impostos
  icms             Float?
  icmsReduction    Float?
  ipi              Float?
  ipiReturn        Float?
  pis              Float?
  cofins           Float?
  cstCsosn         String?
  cfopInsideState  String?
  cfopOutsideState String?
  icmsSt           Float?
  ncm              String?
  mva              Float?
  taxSubstitution  Boolean @default(false)
  ncmDescription   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceItems     InvoiceItem[]
  productSuppliers ProductSupplier[]
  services         ServiceProduct[]
  comboProducts    ComboProduct[]
  batches          ProductBatch[]
  movements        StockMovement[]
  controlledLogs   ControlledSubstanceLog[]

  @@map("products")
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name          String
  document      String? // CNPJ ou CPF
  contactPerson String?
  phone         String?
  email         String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productSuppliers ProductSupplier[]

  @@map("suppliers")
}

model ProductSupplier {
  productId  String
  supplierId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  supplierCode         String?
  lastPrice            Float?
  deliveryLeadTimeDays Int?
  isMainSupplier       Boolean   @default(false)
  lastPurchaseDate     DateTime?

  @@id([productId, supplierId])
  @@map("product_suppliers")
}

model Tutor {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  cpf            String?
  gender         String?      // Masculino, Feminino, Outro
  phone          String?
  email          String?      @unique
  password       String?
  address        String?
  street         String?
  number         String?
  neighborhood   String?
  city           String?
  state          String?
  zipCode        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patients           Patient[]
  invoices           Invoice[]
  appointments       Appointment[]
  signatureDocuments SignatureDocument[]
  waitlistEntries    WaitlistEntry[]

  @@map("tutors")
}

model Patient {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  tutorId        String
  tutor          Tutor        @relation(fields: [tutorId], references: [id])
  speciesId      String
  species        Species      @relation(fields: [speciesId], references: [id])
  breedId        String?
  breed          Breed?       @relation(fields: [breedId], references: [id])
  name           String
  birthDate      DateTime?
  weight         Float?
  gender         String?      // Macho, Fêmea
  neutered       String?      // SIM, NAO, SEM_INFORMACAO
  coatColor      String?      // Cor da pelagem
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  alerts             PatientAlert[]
  records            ClinicalRecord[]
  vaccines           Vaccine[]
  appointments       Appointment[]
  signatureDocuments SignatureDocument[]
  waitlistEntries    WaitlistEntry[]
  hospitalizations   Hospitalization[]

  @@map("patients")
}

model PatientAlert {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  description String
  severity    String   @default("low")
  createdAt   DateTime @default(now())

  @@map("patient_alerts")
}

model ClinicalRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  veterinarianId String
  veterinarian   User         @relation(fields: [veterinarianId], references: [id])
  status         String       @default("open")
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?

  events             TimelineEvent[]
  examRequests       ExamRequest[]
  invoices           Invoice[]
  signatureDocuments SignatureDocument[]

  @@map("clinical_records")
}

model TimelineEvent {
  id               String         @id @default(uuid())
  clinicalRecordId String
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  type             String
  title            String
  description      String?
  data             String?
  createdBy        String
  user             User           @relation(fields: [createdBy], references: [id])
  createdAt        DateTime       @default(now())

  @@map("timeline_events")
}

model Vaccine {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  dose        String?
  dateApplied DateTime?
  nextDueDate DateTime?
  createdAt   DateTime  @default(now())

  @@map("vaccines")
}

model ExamRequest {
  id               String         @id @default(uuid())
  clinicalRecordId String
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  type             String
  status           String         @default("pending")
  results          String?
  createdAt        DateTime       @default(now())

  @@map("exam_requests")
}

model Invoice {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  tutorId          String
  tutor            Tutor           @relation(fields: [tutorId], references: [id])
  clinicalRecordId String?
  clinicalRecord   ClinicalRecord? @relation(fields: [clinicalRecordId], references: [id])
  totalAmount      Float           @default(0)
  discount         Float?          @default(0)
  notes            String?
  status           String          @default("pending")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  items      InvoiceItem[]
  payments   Payment[]
  fiscalNote FiscalNote?

  @@map("invoices")
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id])
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  comboId    String?
  combo      Combo?   @relation(fields: [comboId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Float
  totalPrice Float

  @@map("invoice_items")
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String
  date      DateTime @default(now())

  @@map("payments")
}

model Appointment {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  patientId            String
  patient              Patient      @relation(fields: [patientId], references: [id])
  tutorId              String
  tutor                Tutor        @relation(fields: [tutorId], references: [id])
  veterinarianId       String
  veterinarian         User         @relation(fields: [veterinarianId], references: [id])
  date                 DateTime
  type                 String       @default("consulta") // consulta, retorno, exame, cirurgia, vacina, banho_tosa
  durationInMinutes    Int          @default(30)
  whatsappReminderSent Boolean      @default(false)
  groupId              String?      // Para pacotes recorrentes
  pipelineId           String?
  pipeline             Pipeline?    @relation(fields: [pipelineId], references: [id])
  stageId              String?
  stage                PipelineStage? @relation(fields: [stageId], references: [id])
  status               String       @default("scheduled") // scheduled, confirmed, waiting, in_progress, completed, canceled, no_show
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("appointments")
}

model WaitlistEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])
  tutorId        String
  tutor          Tutor        @relation(fields: [tutorId], references: [id])
  preferredDate  DateTime?
  notes          String?
  status         String       @default("pending") // pending, scheduled, canceled
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("waitlist_entries")
}

model Pipeline {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String          // Ex: "Esteira de Consultas"
  color          String?
  stages         PipelineStage[]
  appointments   Appointment[]

  @@map("pipelines")
}

model PipelineStage {
  id             String        @id @default(uuid())
  pipelineId     String
  pipeline       Pipeline      @relation(fields: [pipelineId], references: [id])
  name           String        
  color          String        @default("gray")
  order          Int           
  appointments   Appointment[]

  @@map("pipeline_stages")
}

model FiscalNote {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceId      String       @unique
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  type      String // NFE, NFCE, NFSE
  status    String  @default("PENDING") // PENDING, PROCESSING, AUTHORIZED, REJECTED, CANCELED
  number    String?
  series    String?
  accessKey String?
  protocol  String?
  xmlData   String?
  pdfUrl    String?
  message   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fiscal_notes")
}

model SignatureDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id])

  tutorId String?
  tutor   Tutor?  @relation(fields: [tutorId], references: [id])

  clinicalRecordId String?
  clinicalRecord   ClinicalRecord? @relation(fields: [clinicalRecordId], references: [id])

  title      String
  content    String // Texto ou HTML do termo
  status     String @default("PENDING") // PENDING, SIGNED, CANCELLED
  magicToken String @unique @default(uuid())

  signatureData String? // Base64 PNG
  signedAt      DateTime?
  ipAddress     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("signature_documents")
}

model DocumentTemplate {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  content        String // Conteúdo com variáveis tipo {{PATIENT_NAME}}
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("document_templates")
}

model Bed {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String       // Ex: "Baia 01 - Canil", "Leito UTI 02"
  sector         String       @default("Geral") // Canil, Gatil, UTI, Isolamento
  status         String       @default("DISPONIVEL") // DISPONIVEL, OCUPADO, MANUTENCAO, HIGIENIZACAO
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  hospitalizations Hospitalization[]

  @@map("beds")
}

model Hospitalization {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  patientId         String
  patient           Patient      @relation(fields: [patientId], references: [id])
  bedId             String?
  bed               Bed?         @relation(fields: [bedId], references: [id])
  veterinarianId    String
  veterinarian      User         @relation(fields: [veterinarianId], references: [id])
  
  reason            String       // Motivo da internação / diagnóstico inicial
  isolation         Boolean      @default(false)
  status            String       @default("ACTIVE") // ACTIVE, DISCHARGED, DECEASED, TRANSFERRED
  admittedAt        DateTime     @default(now())
  dischargedAt      DateTime?
  expectedDischarge DateTime?
  dischargeNotes    String?

  prescriptions     HospitalPrescription[]
  shiftHandovers    ShiftHandover[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("hospitalizations")
}

model HospitalPrescription {
  id                String          @id @default(uuid())
  hospitalizationId String
  hospitalization   Hospitalization @relation(fields: [hospitalizationId], references: [id], onDelete: Cascade)
  medicationName    String          // Nome do medicamento ou insumo
  dosage            String          // Dosagem ex: 10mg/kg, 2 comprimidos
  route             String          // Via ex: IV, SC, VO, IM
  frequencyInHours  Int             // Intervalo em horas ex: 4, 6, 8, 12, 24
  instructions      String?         // Recomendações/observações de aplicação
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  administrations   PrescriptionAdministration[]

  @@map("hospital_prescriptions")
}

model PrescriptionAdministration {
  id             String               @id @default(uuid())
  prescriptionId String
  prescription   HospitalPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  scheduledTime  DateTime             // Horário previsto da dose
  administeredAt DateTime?            // Horário em que foi efetivamente aplicado
  administeredBy String?              // ID do usuário/técnico que administrou
  user           User?                @relation(fields: [administeredBy], references: [id])
  status         String               @default("PENDING") // PENDING, ADMINISTERED, SKIPPED, CANCELLED
  notes          String?
  batchNumber    String?              // Lote do produto utilizado
  createdAt      DateTime             @default(now())

  @@map("prescription_administrations")
}

model ShiftHandover {
  id                String           @id @default(uuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  hospitalizationId String?
  hospitalization   Hospitalization? @relation(fields: [hospitalizationId], references: [id])
  authorId          String
  author            User             @relation(fields: [authorId], references: [id])
  shift             String           // "MANHA", "TARDE", "NOITE"
  patientStatus     String           // "ESTAVEL", "CRITICO", "EM_OBSERVACAO", "MELHORA"
  summaryNotes      String           // Resumo das intercorrências e condutas do plantão
  createdAt         DateTime         @default(now())

  @@map("shift_handovers")
}

model ProductBatch {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber      String
  manufacturingDate DateTime?
  expirationDate   DateTime
  quantity         Float     @default(0)
  costPrice        Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  movements StockMovement[]

  @@map("product_batches")
}

model StockMovement {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  batchId        String?
  batch          ProductBatch? @relation(fields: [batchId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])

  type        String // ENTRADA, SAIDA_CONSULTA, SAIDA_INTERNACAO, AJUSTE, PERDA
  quantity    Float
  reason      String?
  createdAt   DateTime @default(now())

  @@map("stock_movements")
}

model ControlledSubstanceLog {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  productId          String
  product            Product      @relation(fields: [productId], references: [id])
  
  type               String       // ENTRADA, SAIDA
  quantity           Float
  balanceAfter       Float
  prescriptionNumber String?
  vetName            String?
  vetCrmv            String?
  tutorName          String?
  notes              String?
  createdAt          DateTime     @default(now())

  @@map("controlled_substance_logs")
}
